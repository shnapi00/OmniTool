{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniTool",
  "version": "1.0.0",
  "identifier": "com.omnitool.desktop",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OmniTool",
        "width": 980,
        "height": 650,
        "minWidth": 820,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "bin/*",
      "resources/*",
      "resources/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "startMenuFolder": "OmniTool",
        "installerHooks": "hooks.nsh"
      }
    }
  }
}